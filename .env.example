# Solana RPC endpoint used to read on-chain Orca Whirlpool state.
# Public endpoints are rate-limited; get a free/paid RPC URL from Helius,
# QuickNode, Triton, etc. for reliable polling.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# How often to scan all configured pairs, in milliseconds.
POLL_INTERVAL_MS=15000

# Minimum net spread (in basis points, 1 bps = 0.01%) required before an
# opportunity is logged. Net = gross spread - ASSUMED_COST_BUFFER_BPS.
MIN_PROFIT_BPS=15

# Flat buffer (in basis points) subtracted from the gross spread to
# approximate what a real round trip would lose to network fees, priority
# fees, and price movement between the two swaps. This is a simplification
# for simulation purposes only - see README for details.
ASSUMED_COST_BUFFER_BPS=10

# Where simulated opportunities are appended as JSON lines.
LOG_FILE=./logs/opportunities.jsonl
